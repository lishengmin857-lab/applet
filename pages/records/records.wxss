.container {
  padding: 30rpx 40rpx;
  box-sizing: border-box;
}

.page-header {
  padding: 10rpx 8rpx 30rpx 8rpx;
  margin-bottom: 20rpx;
}

.page-header .text-sm {
  margin-top: 8rpx;
  display: block;
}

.records-container {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  width: 100%;
}

.record-card {
  padding: 36rpx;
  margin-bottom: 0;
  width: 100%;
}

.record-card-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.record-style-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 24rpx;
}

.tag-funny {
  background-color: #FAF4EF;
  color: #A68D79;
  border: 2rpx solid rgba(166, 141, 121, 0.2);
}

.tag-sincere {
  background-color: #F2F8F4;
  color: #79A68D;
  border: 2rpx solid rgba(121, 166, 141, 0.2);
}

.tag-professional {
  background-color: #F4F5FB;
  color: #8D79A6;
  border: 2rpx solid rgba(141, 121, 166, 0.2);
}

.record-time {
  font-size: 22rpx;
  color: #B5ADA6;
}

.record-content-box {
  background-color: rgba(255, 255, 255, 0.45);
  border: 2rpx solid rgba(166, 146, 121, 0.06);
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #756A60;
}

.record-orig-text {
  font-size: 22rpx;
  color: #B5ADA6;
  border-bottom: 2rpx dashed rgba(166, 146, 121, 0.1);
  padding-bottom: 12rpx;
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.record-gen-text {
  user-select: text;
  display: block;
  word-break: break-all;
  white-space: pre-wrap;
}

.record-actions {
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  gap: 16rpx;
}

.record-action-btn {
  background: #FFFFFF;
  border: 2rpx solid rgba(166, 146, 121, 0.15);
  border-radius: 28rpx;
  padding: 12rpx 24rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #756A60;
  margin: 0;
  line-height: 1;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(166,146,121,0.02);
}

.record-action-btn::after {
  display: none;
}

.record-action-btn:active {
  background: #F7F5F2;
}

.record-action-btn.btn-copy {
  background-color: #B89B82;
  color: #FFFFFF;
  border-color: #B89B82;
}

.record-action-btn.btn-copy:active {
  background-color: #A68D79;
}

.record-action-btn.btn-del {
  color: #EF4444;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 40rpx;
  text-align: center;
  width: 100%;
}

.empty-icon-feather {
  width: 128rpx;
  height: 128rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23B9B0A7' stroke-width='1.5'%3E%3Cpath d='M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z'/%3E%3Cline x1='16' y1='8' x2='2' y2='22'/%3E%3C/svg%3E");
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #B5ADA6;
  margin-bottom: 40rpx;
  display: block;
}

.empty-action-btn {
  border: 3rpx solid #B89B82;
  border-radius: 36rpx;
  background-color: transparent;
  color: #B9B0A7;
  padding: 16rpx 48rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.empty-action-btn::after {
  display: none;
}

.empty-action-btn:active {
  background-color: rgba(184, 155, 130, 0.1);
}
