.container {
  padding: 30rpx 40rpx;
  box-sizing: border-box;
}

/* User Profile Card */
.user-profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
  margin-top: 10rpx;
  padding: 36rpx;
  width: 100%;
}

.profile-avatar {
  width: 96rpx;
  height: 96rpx;
  background: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(166, 146, 121, 0.08);
}

.icon-avatar {
  width: 56rpx;
  height: 56rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23B89B82' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2'/%3E%3Ccircle cx='12' cy='7' r='4'/%3E%3C/svg%3E");
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.profile-username {
  font-size: 32rpx;
  font-weight: 700;
  color: #756A60;
}

.vip-tag {
  background: #EAE5DF;
  color: #8D7762;
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: bold;
}

.vip-tag.active {
  background: linear-gradient(180deg, #E8D5BF 0%, #B89B82 100%);
  color: #FFFFFF;
}

.profile-uid {
  font-size: 22rpx;
  color: #B5ADA6;
}

/* Stats Grid */
.stats-grid {
  display: flex;
  flex-direction: row;
  gap: 28rpx;
  margin-top: 32rpx;
  margin-bottom: 32rpx;
  width: 100%;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 32rpx 20rpx;
  margin-bottom: 0;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #756A60;
}

.stat-title {
  font-size: 22rpx;
  color: #B5ADA6;
  margin-top: 8rpx;
  font-weight: 600;
}

/* Settings List */
.settings-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  width: 100%;
}

.setting-item {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 2rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 32rpx 0 rgba(166, 146, 121, 0.1);
  border-radius: 36rpx;
  padding: 32rpx 40rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 600;
  color: #756A60;
  width: 100%;
}

.setting-item:active {
  background: rgba(255, 255, 255, 0.85);
}

.setting-item-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.icon-setting {
  width: 36rpx;
  height: 36rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.icon-vip {
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23B89B82' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z'/%3E%3Cpath d='M3 20h18'/%3E%3C/svg%3E");
}

.icon-share {
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23B5ADA6' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Ccircle cx='18' cy='5' r='3'/%3E%3Ccircle cx='6' cy='12' r='3'/%3E%3Ccircle cx='18' cy='19' r='3'/%3E%3Cline x1='8.59' y1='13.51' x2='15.42' y2='17.49'/%3E%3Cline x1='15.41' y1='6.51' x2='8.59' y2='10.49'/%3E%3C/svg%3E");
}

.icon-guide {
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23B5ADA6' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z'/%3E%3Cpath d='M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z'/%3E%3C/svg%3E");
}

.icon-contact {
  background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23B5ADA6' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z'/%3E%3C/svg%3E");
}

.item-arrow {
  font-size: 32rpx;
  color: #C3B5A7;
  line-height: 1;
}

.item-action-text {
  font-size: 24rpx;
  color: #B9B0A7;
  font-weight: 700;
}

.item-action-text.vip-active {
  color: #79A68D;
}

/* Button Wrapper Reset */
.setting-item-btn-wrapper {
  background: transparent;
  padding: 0;
  margin: 0;
  line-height: inherit;
  font-weight: inherit;
  border-radius: 0;
  border: none;
  text-align: left;
  width: 100%;
}

.setting-item-btn-wrapper::after {
  display: none;
}

.version-info {
  display: flex;
  justify-content: center;
  margin-top: 38rpx;
  padding-bottom: 140rpx;
  color: #B5ADA6;
  font-size: 22rpx;
  line-height: 1.5;
}
