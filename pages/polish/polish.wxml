<view class="container">
  <!-- Brand Banner -->
  <view class="brand-banner">
    <view class="brand-left">
      <!-- SVG Brand Logo Feather -->
      <view class="brand-logo-squircle">🪶</view>
      
      <view class="title-container">
        <text class="brand-title serif-title">文案润色</text>
        <text class="brand-subtitle">多重文风转换 · 快速优化升级</text>
      </view>
    </view>
    
    <button class="guide-btn" bindtap="onShowGuide">
      使用指南
      <view class="icon-btn-question"></view>
    </button>
  </view>

  <!-- Input Area Card (Glass style) -->
  <view class="glass-card input-card">
    <textarea class="textarea-input" placeholder-class="textarea-placeholder" placeholder="请输入或粘贴你想要润色的文案..." maxlength="1000" bindinput="onInput" value="{{inputText}}"></textarea>
    
    <view class="input-card-footer">
      <!-- Action Buttons -->
      <view class="input-action-left">
        <button class="paste-pill-btn" bindtap="onPaste">
          <view class="icon-btn-paste"></view>
          粘贴文本
        </button>
        <button class="clear-pill-btn" bindtap="onClear" wx:if="{{inputText}}">
          清空
        </button>
      </view>
      
      <text class="char-counter">{{inputText.length || 0}}/1000</text>
    </view>
  </view>

  <!-- Style Selection -->
  <view class="style-section">
    <view class="style-header-container">
      <view class="style-title">选择风格</view>
      <view class="ai-recommend">
        <view class="icon-recommend-sparkle"></view>
        <text>精选文风推荐</text>
      </view>
    </view>

    <!-- Styles Cards Row -->
    <view class="style-cards-row">
      <!-- Card 1: 幽默 -->
      <view class="style-card card-beige {{selectedStyle === 'funny' ? 'active' : ''}}" bindtap="onSelectStyle" data-style="funny">
        <view class="card-icon-circle">
          <view class="icon-style-funny"></view>
        </view>
        <text class="style-card-title">幽默</text>
        <text class="style-card-desc">轻松诙谐，吸引眼球</text>
      </view>

      <!-- Card 2: 真诚 (Active by default) -->
      <view class="style-card card-green {{selectedStyle === 'sincere' ? 'active' : ''}}" bindtap="onSelectStyle" data-style="sincere">
        <view class="card-icon-circle">
          <view class="icon-style-sincere"></view>
        </view>
        <text class="style-card-title">真诚</text>
        <text class="style-card-desc">走心自然，打动人心</text>
      </view>

      <!-- Card 3: 专业 -->
      <view class="style-card card-purple {{selectedStyle === 'professional' ? 'active' : ''}}" bindtap="onSelectStyle" data-style="professional">
        <view class="card-icon-circle">
          <view class="icon-style-professional"></view>
        </view>
        <text class="style-card-title">专业</text>
        <text class="style-card-desc">严谨专业，增强信任</text>
      </view>

      <!-- Card 4: 诗词 -->
      <view class="style-card card-teal {{selectedStyle === 'poetry' ? 'active' : ''}}" bindtap="onSelectStyle" data-style="poetry">
        <view class="card-icon-circle">
          <view class="icon-style-poetry"></view>
        </view>
        <text class="style-card-title">诗词</text>
        <text class="style-card-desc">古风雅韵，意境深远</text>
      </view>

      <!-- Card 5: 唯美 -->
      <view class="style-card card-pink {{selectedStyle === 'aesthetic' ? 'active' : ''}}" bindtap="onSelectStyle" data-style="aesthetic">
        <view class="card-icon-circle">
          <view class="icon-style-aesthetic"></view>
        </view>
        <text class="style-card-title">唯美</text>
        <text class="style-card-desc">温柔治愈，画面感强</text>
      </view>

      <!-- Card 6: 浪漫 -->
      <view class="style-card card-orange {{selectedStyle === 'romantic' ? 'active' : ''}}" bindtap="onSelectStyle" data-style="romantic">
        <view class="card-icon-circle">
          <view class="icon-style-romantic"></view>
        </view>
        <text class="style-card-title">浪漫</text>
        <text class="style-card-desc">字句温柔，浪漫心动</text>
      </view>
    </view>

    <view class="length-section">
      <view class="length-header">
        <text class="length-title">字数选择</text>
      </view>

      <view class="length-options">
        <view
          wx:for="{{lengthOptions}}"
          wx:key="*this"
          class="length-option {{selectedMaxChars === item ? 'active' : ''}}"
          bindtap="onSelectLength"
          data-length="{{item}}"
        >
          <text class="length-number">{{item}}</text>
          <text class="length-unit">字</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Main Generate Button -->
  <view class="generate-btn-container">
    <button class="satin-gold-btn" bindtap="onGenerate">
      <text class="star-icon">✦</text>
      开始润色
    </button>
  </view>

  <!-- Loading Modal -->
  <view class="loading-overlay" wx:if="{{loading}}">
    <view class="loading-card glass-modal">
      <view class="loading-spinner"></view>
      <text class="loading-text">文案润色中...</text>
    </view>
  </view>

  <!-- Result Modal Popup -->
  <view class="modal-overlay" wx:if="{{showResultModal}}">
    <view class="result-modal-card glass-modal">
      <view class="modal-header">
        <text class="modal-header-title">✨ 润色结果</text>
        <text class="result-badge-style">{{selectedStyleName}}</text>
      </view>
      
      <view class="modal-body-content">
        <text class="result-text-area" user-select="true">{{currentResult.resultText}}</text>
      </view>
      
      <view class="modal-footer-buttons">
        <button class="modal-action-btn copy-btn" bindtap="onCopyResult">
          <view class="icon-modal-copy"></view>
          一键复制
        </button>
      </view>
      
      <view class="modal-close-row">
        <button class="modal-secondary-btn" bindtap="onRegenerate">重新生成</button>
        <button class="modal-secondary-btn" bindtap="onCloseModal">关闭</button>
      </view>
    </view>
  </view>

  <!-- Include tab-bar -->
  <include src="../../templates/tabbar.wxml" />
</view>
